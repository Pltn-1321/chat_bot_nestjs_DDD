// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider   = "prisma-client-js"
  engineType = "binary"  // Utilise le moteur binaire PostgreSQL (pas le nouveau moteur WebAssembly)
}

// En Prisma 7, l'URL de connexion est configurée dans prisma.config.ts
datasource db {
  provider = "postgresql"
}

// ============================================
// MODÈLES MÉTIER - Gestion des Interventions
// ============================================

/// Un intervenant est une personne qui réalise des missions d'enseignement
model Intervenant {
  id         Int       @id @default(autoincrement())
  nom        String
  email      String    @unique
  telephone  String?
  specialite String

  // Relation one-to-many : un intervenant peut avoir plusieurs missions
  missions   Mission[]

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@map("intervenants") // Nom de la table en base
}

/// Une mission est une intervention d'enseignement assignée à un intervenant
model Mission {
  id            Int          @id @default(autoincrement())
  titre         String
  date          DateTime
  duree         Int          // Durée en minutes
  lieu          String

  // Relation many-to-one : une mission appartient à un intervenant (optionnel)
  intervenant   Intervenant? @relation(fields: [intervenantId], references: [id])
  intervenantId Int?

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@map("missions") // Nom de la table en base
}

// ============================================
// MODÈLES CHAT - Chatbot avec Tools
// ============================================

/// Une conversation regroupe un ensemble de messages échangés avec le chatbot
model Conversation {
  id        String    @id @default(uuid())
  title     String?   // Titre optionnel (généré à partir du premier message)
  messages  Message[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("conversations")
}

/// Un message dans une conversation (utilisateur, assistant, ou résultat d'outil)
model Message {
  id             String       @id @default(uuid())

  // Relation avec la conversation
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String

  // Type de message : 'user' | 'assistant' | 'tool'
  role           String

  // Contenu textuel (nullable pour les appels d'outils)
  content        String?

  // Pour les messages assistant avec appels d'outils
  toolCalls      Json?        // Array de {id, name, arguments}

  // Pour les messages de résultat d'outil
  toolCallId     String?
  toolName       String?

  createdAt      DateTime     @default(now())

  @@index([conversationId])
  @@map("messages")
}
